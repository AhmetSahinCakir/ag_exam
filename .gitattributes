# Metin dosyaları depoda LF tutulur.
* text=auto eol=lf

# Windows betikleri CRLF ile çıkarılmalı (cmd.exe LF satır sonlarıyla etiketleri bulamayabilir).
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
*.iss text eol=crlf

*.pka binary
*.png binary
*.ico binary
*.xlsx binary
*.zip binary
